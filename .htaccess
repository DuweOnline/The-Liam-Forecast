# BEGIN Security
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Don't advertise the PHP version
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Content Security Policy - what pages may load, and from where:
  #  - 'unsafe-inline': the inline Google Tag Manager snippet. A hash or per-request nonce isn't workable
  #    here because the host's CDN minifies the HTML (changing the hash) and caches pages (reusing nonces).
  #  - blob: and 'unsafe-inline': CookieYes holds scripts back until consent, then re-runs them as
  #    inline and blob: scripts.
  #  - googletagmanager, google-analytics, doubleclick, googleadservices, googlesyndication, google.com:
  #    the GTM container (GA4 and Google Ads tags)
  #  - cdn-cookieyes.com (scripts, images and banner settings) and log.cookieyes.com (consent logging):
  #    the cookie banner, loaded through GTM. cdn-cookieyes.com is its own domain, so *.cookieyes.com
  #    doesn't cover it.
  #  - cdn.jsdelivr.net / unpkg.com and 'wasm-unsafe-eval': the Lottie player downloads and compiles
  #    its WebAssembly renderer
  #  - 'unsafe-eval': the Lottie player's WebAssembly glue code builds functions with new Function(),
  #    so without it the weather animations fail to load.
  # Every other page output is escaped, and scripts can still only load from the hosts listed here.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' blob: 'wasm-unsafe-eval' 'unsafe-eval' https://*.googletagmanager.com https://cdn-cookieyes.com https://pagead2.googlesyndication.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://*.google.co.uk https://cdn-cookieyes.com; font-src 'self'; media-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://pagead2.googlesyndication.com https://cdn-cookieyes.com https://*.cookieyes.com; frame-src https://www.googletagmanager.com https://td.doubleclick.net; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
<IfModule mod_alias.c>
  # Source control, build sources, local config, source maps and old builds aren't for visitors
  RedirectMatch 404 ^/(\.git|\.github|\.nova|tailwind)(/|$)
  RedirectMatch 404 (/config\.local[^/]*\.php|_old\.(js|css)|\.map)$
</IfModule>
# END Security

# BEGIN Caching
# Cache-Control only - mod_expires is switched off so the two can't send conflicting lifetimes.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  # CSS and JS are requested with ?v= in index.php, so they can be kept for a year.
  # Bump that version whenever either file changes.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images, fonts, audio and animations aren't versioned, so a month lets replacements show up
  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico|woff2?|ttf|mp3|lottie|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
# Pages set their own Cache-Control in PHP (index.php revalidates; admin pages are no-store)
# END Caching

# BEGIN Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon font/ttf font/otf
</IfModule>
# END Compression

# BEGIN MIME types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/zip .lottie
</IfModule>
# END MIME types
